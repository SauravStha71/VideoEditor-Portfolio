# ─────────────────────────────────────────────────────────────────────────────
# Environment variable template — copy to .env.local and fill in real values.
# .env.local is git-ignored; this file (.env.example) IS committed as a guide.
# ─────────────────────────────────────────────────────────────────────────────

# Cloudinary — used by scripts/generate-manifest.js (server-side only, never in the browser)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Cloudinary cloud name exposed to the browser bundle via Vite
# (cloud name is not a secret but keeping it configurable enables rotation)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
